---
import { getPageData, SITE_ORIGIN, type SitePage } from '../lib/seo';
export interface Props {
  page?: SitePage;
  title?: string;
  description?: string;
  article?: boolean;
}
const { page = getPageData('overview', 'es') } = Astro.props;
const title = Astro.props.title ?? page.title;
const description = Astro.props.description ?? page.description;
const canonical = page.canonical;
const portrait = `${SITE_ORIGIN}/images/carlos-plasencia.png`;
const portraitAlt = page.language === 'es' ? 'Retrato profesional de Carlos Plasencia' : 'Professional portrait of Carlos Plasencia';
const structuredData = page.structuredData;
---

<!doctype html>
<html lang={page.language} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Carlos Eduardo Plasencia Prado" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#090d14" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={page.alternates.es} />
    {page.alternates.en && <link rel="alternate" hreflang="en" href={page.alternates.en} />}
    <link rel="alternate" hreflang="x-default" href={page.alternates.default} />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={Astro.props.article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Carlos Plasencia" />
    <meta property="og:locale" content={page.language === 'es' ? 'es_PE' : 'en_US'} />
    {page.alternates.en && <meta property="og:locale:alternate" content={page.language === 'es' ? 'en_US' : 'es_PE'} />}
    <meta property="og:image" content={portrait} />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content={portraitAlt} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={portrait} />
    <meta name="twitter:image:alt" content={portraitAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body class="workspace-page antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/globals.css';
</style>
