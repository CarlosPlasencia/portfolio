---
import type { GetStaticPaths } from 'astro';
import WorkspacePreview from '../../../components/workspace/WorkspacePreview';
import { BLOG_DRAFT, getBlogDraftPaths } from '../../../lib/blog-preview';
import { Content, frontmatter } from '../../../content/blog/corregir-bug-con-ia.md';
import '../../../styles/globals.css';
import '../../../styles/workspace.css';

export const getStaticPaths = (() => getBlogDraftPaths(import.meta.env.DEV)) satisfies GetStaticPaths;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#090d14" />
    <title>{frontmatter.title} | Borrador · CaleduDev</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="workspace-page antialiased">
    <WorkspacePreview initialEntry="blog" initialLanguage="es" routed={true} client:load>
      <article class="ws-blog-reading">
        <a class="ws-text-link" href="/blog/">← Volver al blog</a>
        <p class="ws-blog-draft-label">Borrador · Solo en local · En español</p>
        <h1 id="ws-main-title">{BLOG_DRAFT.title}</h1>
        <p class="ws-blog-byline">{frontmatter.author} · Desarrollo e IA, paso a paso.</p>
        <div class="ws-blog-prose"><Content /></div>
      </article>
    </WorkspacePreview>
  </body>
</html>
